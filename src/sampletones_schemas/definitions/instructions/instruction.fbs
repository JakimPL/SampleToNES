include "instructions/pulse.fbs";
include "instructions/triangle.fbs";
include "instructions/noise.fbs";

namespace sampletones_schemas.instructions;

union FBInstructionUnion {
    sampletones_schemas.instructions.FBPulseInstruction,
    sampletones_schemas.instructions.FBTriangleInstruction,
    sampletones_schemas.instructions.FBNoiseInstruction
}

table FBInstructionData {
    instruction_class: string;
    instruction: FBInstructionUnion;
}

root_type FBInstructionData;
